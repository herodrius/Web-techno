# Remplir uniquement côté Express. Ne jamais mettre la clé Supabase dans React.
SUPABASE_URL=
SUPABASE_KEY=

# Local, avant création du projet Supabase : true = données de démonstration en mémoire.
# Une fois Supabase configuré, mettre false. Aucune copie automatique vers la base.
DEMO_MODE=true
PORT=3000
CORS_ORIGINS=https://web-techno-ten.vercel.app

# Code privé de gestion, distinct de la clé Supabase. Requis avec NODE_ENV=production.
ADMIN_TOKEN=
